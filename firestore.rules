rules_version='2';service cloud.firestore{match /databases/{db}/documents{function signed(){return request.auth!=null}function admin(){return signed()&&request.auth.token.admin==true}match /users/{uid}{allow read,create,update:if signed()&&request.auth.uid==uid;allow list,delete:if admin()}match /menuItems/{id}{allow read:if resource.data.isAvailable==true||admin();allow create,update,delete:if admin()}match /categories/{id}{allow read:if resource.data.isActive==true||admin();allow write:if admin()}match /tables/{id}{allow read:if signed();allow write:if admin()}match /orders/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid;allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);allow update:if admin()||(signed()&&resource.data.userId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']));allow delete:if admin()}match /reservations/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid;allow read:if admin()||(signed()&&resource.data.userId==request.auth.uid);allow update:if admin()||(signed()&&resource.data.userId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));allow delete:if admin()}match /reservationSlots/{id}{allow read:if signed();allow create:if signed()&&!exists(/databases/$(db)/documents/reservationSlots/$(id));allow update,delete:if admin()}match /reviews/{id}{allow read:if resource.data.approved==true||admin();allow create:if signed()&&request.resource.data.userId==request.auth.uid;allow update,delete:if admin()}match /offers/{id}{allow read:if resource.data.active==true||admin();allow write:if admin()}match /gallery/{id}{allow read:if resource.data.active==true||admin();allow write:if admin()}match /contactMessages/{id}{allow create:if true;allow read,update,delete:if admin()}match /settings/{id}{allow read:if true;allow write:if admin()}}}